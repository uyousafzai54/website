{
  "name": "ingress",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-10-02",
  "routes": [
    {
      "pattern": "www.uyousafz.com/*",
      "zone_name": "uyousafz.com"
    },
    {
      "pattern": "uyousafz.com/*",
      "zone_name": "uyousafz.com"
    },
    {
      "pattern": "uyousafz.dev",
      "zone_name": "uyousafz.dev",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    },
    {
      "pattern": "umaryousafzai.net",
      "zone_name": "umaryousafzai.net",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    },
    "issues": {
      "enabled": true
    }
  },
  "assets": {
     "directory": "./public"
  }
}